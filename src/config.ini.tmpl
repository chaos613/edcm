; Section names become collection names. Library is optional and exact-match.
; Name matches Emby's Name field, including Home Videos & Photos filenames.

; [Family Videos]
; Library = Home Videos & Photos
; Type = Video
; Name = *vacation*
; IncludeVideo = true
; IncludeFolders = false
; IncludePhotos = false

; [2024 Family Vacation Videos]
; Name = *vacation*
; Genres = Documentary
; Tags = Family
; Years = 2024
; IncludeVideo = true
; IncludeFolders = false
; IncludePhotos = false

; [Highly Rated HBO Series]
; Library = TV Shows
; IncludeItemTypes = Series
; Studios = HBO*
; MinCommunityRating = 8

; Compound rules separate patterns with |. Any requires one match, All requires every match,
; and Exclude rejects any match. Different rule lines combine with AND semantics.
; [Family Water Trips]
; NameAny = *vacation* | *boat* | *beach*
; NameAll = *family*
; ExcludeName = *surf* | *trailer*
; GenresAny = Documentary | Travel
; GenresAll = Family
; ExcludeGenres = Archive | Horror
; IncludeVideo = true
; IncludeFolders = false
; IncludePhotos = false
; DryRun = false
